# ==================================== DATA ORCHESTRATION COMPONENTS ENVIRONMENT VARIABLES ====================================
#Base path to which all the files will be volumed | Default: .
AIRFLOW_PROJ_DIR=./airflow-volumes
#User ID in Airflow containers. Automatically generated through the command `id -u` when running the commande `make dotenv`  | Default: 50000
AIRFLOW_UID=1000
#Path to the local directory where raw json files will be uploaded for ingestion in the Bronze bucket. Mount as a volume to "/opt/airflow/local-data" internal directory inside airflow containers
LOCAL_DATA_DIR=./data
# Exposed port for Airflow's Postgres metadata database
AIRFLOW_POSTGRES_PORT=5432

# ==================================== DATA STORAGE COMPONENTS ENVIRONMENT VARIABLES ====================================
#Base path to which all the files will be volumed
MINIO_PROJ_DIR=./minio-volumes
# Exposed port for MinIO's API
MINIO_API_PORT=9008
# Exposed port for MinIO's web console
MINIO_CONSOLE_PORT=9009



# ==================================== BI COMPONENTS ENVIRONMENT VARIABLES ====================================
# Apache Superset docker image's version used
SUPERSET_IMAGE_TAG=6.0.0
# Exposed port for Superset's Postgres metadata database
DATABASE_PORT=5432
# Exposed port for Superset's Redis cache database
REDIS_PORT=6379

